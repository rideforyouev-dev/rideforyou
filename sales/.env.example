# Copy to .env and fill privately. Never commit .env.
WAY2CHATS_API_KEY=
WAY2CHATS_PHONE_ID=
WAY2CHATS_URL=https://app.way2chats.com/api/v2/whatsapp-business/messages
# Comma-separated authorized Indian phone numbers in +91 format.
OTP_ALLOWED_PHONES=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=
# Marketing uses the same Way2Chats sender as login and the rental admin.
# Set PUBLIC_ORIGIN to the externally reachable HTTPS origin (no trailing slash).
# Existing BASE_PATH (e.g. /sales) is appended automatically to flyer URLs.
PUBLIC_ORIGIN=
WAY2CHATS_MARKETING_TEXT_TEMPLATE=custom_broadcast
WAY2CHATS_MARKETING_IMAGE_TEMPLATE=custom_broadcast_media
WAY2CHATS_MARKETING_LANGUAGE=en_GB
